# Copy to .env.local. Local values match docker-compose.yml. For Neon use the pooled connection string
# (host contains "-pooler") as DATABASE_URL and the unpooled one as DIRECT_URL.
DATABASE_URL="postgresql://obiadki:obiadki@localhost:54322/obiadki"
DIRECT_URL="postgresql://obiadki:obiadki@localhost:54322/obiadki"
TEST_DATABASE_URL="postgresql://obiadki:obiadki@localhost:54322/obiadki_test"

# Better Auth: a random secret of 32+ characters (e.g. `npx @better-auth/cli secret` or `openssl rand -base64 32`),
# and the app's URL (only needed locally; on Vercel it is taken from Vercel's system variables).
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Only for the one-off spreadsheet import (`npm run db:import`): the Apps Script web app URL (…/exec) and its API_TOKEN.
SHEET_URL=""
SHEET_TOKEN=""
